import 'package:flutter/material.dart';
import 'package:project/env.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:http/http.dart' as http;
import 'dart:convert';

class EventSignupPage extends StatefulWidget {
  final String eventName;
  final int eventId;

  const EventSignupPage({required this.eventName, required this.eventId});
// , required eventId
  @override
  _EventSignupPageState createState() => _EventSignupPageState();
}

class _EventSignupPageState extends State<EventSignupPage> {
  late Map<String, dynamic> _eventDetails;
  bool _hasSignedWaiver = false;
  bool _loading = true;
  bool _isSigningUp = false; // Add loading state for signup process

  @override
  void initState() {
    super.initState();
    _fetchEventDetails();
  }

  Future<void> _fetchEventDetails() async {
    try {
      final volunteerPrefs = await SharedPreferences.getInstance();
      final volunteerSessionToken = volunteerPrefs.getString('volunteer_sessionToken');
      const String apiBaseUrl = Env.apiBaseUrl;

      final response = await http.get(
        Uri.parse('$apiBaseUrl/reports/get_eventdetails?eventName=${widget.eventName}'),
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer $volunteerSessionToken',
        },
      );

      if (response.statusCode == 200) {
        setState(() {
          _eventDetails = jsonDecode(response.body);
          _loading = false;
        });
      } else {
        throw Exception('Failed to fetch event details: ${response.body}');
      }
    } catch (e) {
      setState(() => _loading = false);
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Error loading event details: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  Future<void> _signUpForEvent() async {
    if (!_hasSignedWaiver) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Please sign the waiver to proceed'),
          backgroundColor: Colors.red,
        ),
      );
      return;
    }

    setState(() => _isSigningUp = true);

    try {
      final volunteerPrefs = await SharedPreferences.getInstance();
      final volunteerSessionToken = volunteerPrefs.getString('volunteer_sessionToken');
      final volunteer_userId = volunteerPrefs.getString('volunteer_userId');
      const String apiBaseUrl = Env.apiBaseUrl;
      print('volunteer id is : $volunteer_userId');
      print('All keys in SharedPreferences: ${volunteerPrefs.getKeys()}');
      // print('eventid is : $widget.eventId');



      final response = await http.post(
        Uri.parse('$apiBaseUrl/reports/signup_event'),
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer $volunteerSessionToken',
          'Accept': 'application/json', // Add Accept header
        },
        body: jsonEncode({
          // 'eventName': widget.eventName,
          'eventID': widget.eventId,
          'volunteer_userId': volunteer_userId
        }),
      );

      setState(() => _isSigningUp = false);

      if (response.statusCode == 200) {
        final responseData = jsonDecode(response.body);
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(responseData['message'] ?? 'Signed up successfully!'),
            backgroundColor: Colors.green,
          ),
        );
        Navigator.pop(context);
      } else {
        final errorData = jsonDecode(response.body);
        throw Exception(errorData['error'] ?? 'Failed to sign up for the event');
      }
    } catch (e) {
      setState(() => _isSigningUp = false);
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Error signing up: ${e.toString()}'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFcddcd0),
      appBar: AppBar(
        title: Text(
          widget.eventName,
          style: const TextStyle(fontWeight: FontWeight.bold),
        ),
        backgroundColor: Colors.white,
        elevation: 0,
      ),
      body: _loading
          ? const Center(child: CircularProgressIndicator())
          : SingleChildScrollView(
              child: Padding(
                padding: const EdgeInsets.all(16.0),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    Card(
                      elevation: 4,
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(15),
                      ),
                      child: Padding(
                        padding: const EdgeInsets.all(20.0),
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            const Text(
                              'Event Details',
                              style: TextStyle(
                                fontSize: 24,
                                fontWeight: FontWeight.bold,
                                color: Colors.black87,
                              ),
                            ),
                            const SizedBox(height: 20),
                            _buildDetailRow(
                              Icons.event,
                              'Event Date',
                              _eventDetails['eventDate'],
                            ),
                            _buildDetailRow(
                              Icons.access_time,
                              'Time',
                              '${_eventDetails['startTime']} - ${_eventDetails['endTime']}',
                            ),
                            _buildDetailRow(
                              Icons.location_on,
                              'Location',
                              _eventDetails['eventLocation'],
                            ),
                            _buildDetailRow(
                              Icons.group,
                              'Available Slots',
                              _eventDetails['remainingSlots'].toString(),
                            ),
                          ],
                        ),
                      ),
                    ),
                    const SizedBox(height: 16),
                    Card(
                      elevation: 4,
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(15),
                      ),
                      child: Padding(
                        padding: const EdgeInsets.all(20.0),
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            const Text(
                              'Description',
                              style: TextStyle(
                                fontSize: 20,
                                fontWeight: FontWeight.bold,
                                color: Colors.black87,
                              ),
                            ),
                            const SizedBox(height: 12),
                            Text(
                              _eventDetails['description'],
                              style: const TextStyle(
                                fontSize: 16,
                                color: Colors.black54,
                                height: 1.5,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),
                    const SizedBox(height: 16),
                    Card(
                      elevation: 4,
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(15),
                      ),
                      child: CheckboxListTile(
                        title: const Text(
                          'I confirm that I have signed the waiver',
                          style: TextStyle(
                            fontWeight: FontWeight.w500,
                            color: Colors.black87,
                          ),
                        ),
                        value: _hasSignedWaiver,
                        onChanged: (value) {
                          setState(() => _hasSignedWaiver = value ?? false);
                        },
                        activeColor: Colors.green,
                        checkColor: Colors.white,
                        contentPadding: const EdgeInsets.symmetric(
                          horizontal: 20,
                          vertical: 8,
                        ),
                      ),
                    ),
                    const SizedBox(height: 24),
                    ElevatedButton(
                      onPressed: _isSigningUp ? null : _signUpForEvent,
                      style: ElevatedButton.styleFrom(
                        backgroundColor: Colors.green,
                        padding: const EdgeInsets.symmetric(vertical: 16),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(10),
                        ),
                        elevation: 4,
                      ),
                      child: _isSigningUp
                          ? const SizedBox(
                              height: 20,
                              width: 20,
                              child: CircularProgressIndicator(
                                strokeWidth: 2,
                                valueColor: AlwaysStoppedAnimation<Color>(Colors.white),
                              ),
                            )
                          : const Text(
                              'Sign Up for Event',
                              style: TextStyle(
                                fontSize: 18,
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                    ),
                  ],
                ),
              ),
            ),
    );
  }

  Widget _buildDetailRow(IconData icon, String label, String value) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 16),
      child: Row(
        children: [
          Icon(
            icon,
            color: Colors.green,
            size: 24,
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  label,
                  style: const TextStyle(
                    fontSize: 14,
                    color: Colors.black54,
                    fontWeight: FontWeight.w500,
                  ),
                ),
                const SizedBox(height: 4),
                Text(
                  value,
                  style: const TextStyle(
                    fontSize: 16,
                    color: Colors.black87,
                    fontWeight: FontWeight.w600,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}